diff --git a/src/app/api/account/leave/route.ts b/src/app/api/account/leave/route.ts
new file mode 100644
index 0000000..eae5cf2
--- /dev/null
+++ b/src/app/api/account/leave/route.ts
@@ -0,0 +1,60 @@
+import { z } from "zod";
+import { getSupabaseAdmin } from "@/lib/supabase/admin";
+import { getCurrentUser, requireSameOrigin } from "@/lib/auth";
+import { audit } from "@/lib/audit";
+import { todayCairo } from "@/lib/week";
+
+const date = z.string().regex(/^\d{4}-\d{2}-\d{2}$/);
+const time = z.string().regex(/^([01]\d|2[0-3]):[0-5]\d$/);
+const schema = z.discriminatedUnion("type", [
+  z.object({ type: z.literal("leave"), startDate: date, endDate: date, reason: z.string().trim().min(2).max(500) }),
+  z.object({ type: z.literal("permission"), startDate: date, startTime: time, endTime: time, reason: z.string().trim().min(2).max(500) }),
+]);
+
+export async function POST(request: Request) {
+  if (!(await requireSameOrigin(request))) return Response.json({ error: "الطلب غير صالح" }, { status: 403 });
+  const user = await getCurrentUser();
+  if (!user) return Response.json({ error: "يلزم تسجيل الدخول" }, { status: 401 });
+  if (user.roles.includes("super_admin")) return Response.json({ error: "طلبات الإجازة للموظفين فقط" }, { status: 400 });
+  const parsed = schema.safeParse(await request.json().catch(() => null));
+  if (!parsed.success) return Response.json({ error: "راجع بيانات الطلب" }, { status: 400 });
+  const input = parsed.data;
+  const endDate = input.type === "leave" ? input.endDate : input.startDate;
+  if (Number.isNaN(Date.parse(input.startDate)) || Number.isNaN(Date.parse(endDate))) return Response.json({ error: "تاريخ غير صالح" }, { status: 400 });
+  if (endDate < input.startDate) return Response.json({ error: "نهاية الإجازة قبل بدايتها" }, { status: 400 });
+  if (endDate < todayCairo()) return Response.json({ error: "لا يمكن تقديم طلب بتاريخ سابق" }, { status: 400 });
+  if (input.type === "leave" && Date.parse(endDate) - Date.parse(input.startDate) > 60 * 86400000) return Response.json({ error: "مدة الإجازة أطول من المسموح" }, { status: 400 });
+  if (input.type === "permission" && input.endTime <= input.startTime) return Response.json({ error: "وقت العودة يجب أن يكون بعد وقت الاستئذان" }, { status: 400 });
+
+  const admin = getSupabaseAdmin() as any;
+  const employee = await admin.from("employees").select("id,branch_id").eq("user_id", user.id).maybeSingle();
+  if (employee.error) throw employee.error;
+  const pending = await admin.from("leave_requests").select("id", { count: "exact", head: true }).eq("user_id", user.id).eq("status", "pending");
+  if (pending.error) throw pending.error;
+  if ((pending.count ?? 0) >= 5) return Response.json({ error: "لديك طلبات معلقة كثيرة؛ انتظر مراجعة المالك" }, { status: 429 });
+
+  const { data, error } = await admin.from("leave_requests").insert({
+    user_id: user.id, employee_id: employee.data?.id ?? null, branch_id: employee.data?.branch_id ?? user.branchIds[0] ?? null,
+    request_type: input.type, start_date: input.startDate, end_date: endDate,
+    start_time: input.type === "permission" ? input.startTime : null, end_time: input.type === "permission" ? input.endTime : null,
+    reason: input.reason,
+  }).select("id").single();
+  if (error) throw error;
+  await audit(user.id, `leave.${input.type}.request`, "leave_request", data.id, {});
+  return Response.json({ success: true, id: data.id }, { status: 201 });
+}
+
+// An employee may withdraw a request that has not been decided yet.
+export async function DELETE(request: Request) {
+  if (!(await requireSameOrigin(request))) return Response.json({ error: "الطلب غير صالح" }, { status: 403 });
+  const user = await getCurrentUser();
+  if (!user) return Response.json({ error: "يلزم تسجيل الدخول" }, { status: 401 });
+  const id = z.string().uuid().safeParse(new URL(request.url).searchParams.get("id"));
+  if (!id.success) return Response.json({ error: "طلب غير صالح" }, { status: 400 });
+  const admin = getSupabaseAdmin() as any;
+  const { data, error } = await admin.from("leave_requests").update({ status: "cancelled", decided_at: new Date().toISOString() }).eq("id", id.data).eq("user_id", user.id).eq("status", "pending").select("id");
+  if (error) throw error;
+  if (!data?.length) return Response.json({ error: "لا يمكن إلغاء هذا الطلب" }, { status: 409 });
+  await audit(user.id, "leave.cancel", "leave_request", id.data, {});
+  return Response.json({ success: true });
+}
diff --git a/src/app/api/account/password/route.ts b/src/app/api/account/password/route.ts
new file mode 100644
index 0000000..a0cac2e
--- /dev/null
+++ b/src/app/api/account/password/route.ts
@@ -0,0 +1,32 @@
+import { z } from "zod";
+import { createClient } from "@supabase/supabase-js";
+import { getSupabaseAdmin } from "@/lib/supabase/admin";
+import { getCurrentUser, requireSameOrigin } from "@/lib/auth";
+import { audit } from "@/lib/audit";
+
+const schema = z.object({ currentPassword: z.string().min(1).max(200), newPassword: z.string().min(8).max(72) });
+
+export async function POST(request: Request) {
+  if (!(await requireSameOrigin(request))) return Response.json({ error: "الطلب غير صالح" }, { status: 403 });
+  const user = await getCurrentUser();
+  if (!user) return Response.json({ error: "يلزم تسجيل الدخول" }, { status: 401 });
+  const parsed = schema.safeParse(await request.json().catch(() => null));
+  if (!parsed.success) return Response.json({ error: "كلمة المرور الجديدة يجب ألا تقل عن 8 أحرف" }, { status: 400 });
+  const { currentPassword, newPassword } = parsed.data;
+  if (currentPassword === newPassword) return Response.json({ error: "كلمة المرور الجديدة مطابقة للحالية" }, { status: 400 });
+
+  // Confirm the current password with a throwaway client so the browser session cookies are untouched.
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL, key = process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY;
+  if (!url || !key) throw new Error("Missing Supabase environment variables");
+  const verifier = createClient(url, key, { auth: { autoRefreshToken: false, persistSession: false, detectSessionInUrl: false } });
+  const credentials = user.phone ? { phone: user.phone, password: currentPassword } : user.email ? { email: user.email, password: currentPassword } : null;
+  if (!credentials) return Response.json({ error: "تعذر التحقق من الحساب" }, { status: 400 });
+  const { error: verifyError } = await verifier.auth.signInWithPassword(credentials);
+  if (verifyError) return Response.json({ error: "كلمة المرور الحالية غير صحيحة" }, { status: 400 });
+  await verifier.auth.signOut({ scope: "local" }).catch(() => undefined);
+
+  const { error } = await getSupabaseAdmin().auth.admin.updateUserById(user.id, { password: newPassword });
+  if (error) return Response.json({ error: "تعذر تغيير كلمة المرور؛ جرّب كلمة مرور أقوى" }, { status: 400 });
+  await audit(user.id, "user.password_change", "user", user.id, {});
+  return Response.json({ success: true });
+}
diff --git a/src/app/api/account/route.ts b/src/app/api/account/route.ts
new file mode 100644
index 0000000..dbc52ec
--- /dev/null
+++ b/src/app/api/account/route.ts
@@ -0,0 +1,57 @@
+import { getSupabaseAdmin } from "@/lib/supabase/admin";
+import { getCurrentUser } from "@/lib/auth";
+import { todayCairo, weekRange } from "@/lib/week";
+
+const round2 = (n: number) => Math.round(n * 100) / 100;
+
+// Everything here is scoped to the signed-in user's own record; nothing is read from the request.
+export async function GET() {
+  const user = await getCurrentUser();
+  if (!user) return Response.json({ error: "يلزم تسجيل الدخول" }, { status: 401 });
+  const admin = getSupabaseAdmin() as any;
+  const week = weekRange(todayCairo());
+  const fromIso = week.from.toISOString(), toIso = week.to.toISOString();
+
+  const employeeResult = await admin.from("employees").select("id,branch_id,job_title,base_salary,commission_rate,branches(name)").eq("user_id", user.id).maybeSingle();
+  if (employeeResult.error) throw employeeResult.error;
+  const employee = employeeResult.data as { id: string; branch_id: string; job_title: string; base_salary: number; commission_rate: number; branches: { name: string } | null } | null;
+
+  const [shifts, advances, leaves, payroll, sales] = await Promise.all([
+    admin.from("seller_shifts").select("opened_at,closed_at").eq("user_id", user.id).gte("opened_at", fromIso).lt("opened_at", toIso),
+    admin.from("payroll_advance_requests").select("id,amount,notes,status,created_at,decided_at").eq("user_id", user.id).order("created_at", { ascending: false }).limit(30),
+    admin.from("leave_requests").select("id,request_type,start_date,end_date,start_time,end_time,reason,status,decision_note,created_at,decided_at").eq("user_id", user.id).order("created_at", { ascending: false }).limit(30),
+    employee ? admin.from("payroll_entries").select("id,period_start,period_end,base_salary,commission_amount,deductions,amount_paid,status").eq("employee_id", employee.id).order("period_start", { ascending: false }).limit(12) : Promise.resolve({ data: [], error: null }),
+    employee && Number(employee.commission_rate) > 0
+      ? admin.from("sales").select("grand_total").eq("created_by", user.id).eq("branch_id", employee.branch_id).gte("created_at", fromIso).lt("created_at", toIso).neq("delivery_status", "cancelled")
+      : Promise.resolve({ data: [], error: null }),
+  ]);
+  for (const result of [shifts, advances, leaves, payroll, sales]) if (result.error) throw result.error;
+
+  const hoursSeconds = Math.round((shifts.data ?? []).reduce((sum: number, s: any) => sum + Math.max(0, ((s.closed_at ? Date.parse(s.closed_at) : Date.now()) - Date.parse(s.opened_at)) / 1000), 0));
+  const advanceRows = (advances.data ?? []) as any[];
+  const advancesPaid = advanceRows.filter((a) => a.status === "paid" && a.decided_at && a.decided_at >= fromIso && a.decided_at < toIso).reduce((s, a) => s + Number(a.amount), 0);
+  const advancesPending = advanceRows.filter((a) => a.status === "pending").reduce((s, a) => s + Number(a.amount), 0);
+  const entries = (payroll.data ?? []) as any[];
+  const thisWeekEntry = entries.find((e) => e.period_start === week.start) ?? null;
+
+  let current = null as null | Record<string, number | boolean>;
+  if (employee) {
+    const salesTotal = (sales.data ?? []).reduce((s: number, x: any) => s + Number(x.grand_total), 0);
+    const liveCommission = salesTotal * Number(employee.commission_rate) / 100;
+    const base = thisWeekEntry ? Number(thisWeekEntry.base_salary) : Number(employee.base_salary);
+    const commission = thisWeekEntry ? Number(thisWeekEntry.commission_amount) : liveCommission;
+    const deductions = thisWeekEntry ? Number(thisWeekEntry.deductions) : 0;
+    const salaryPaid = thisWeekEntry ? Number(thisWeekEntry.amount_paid) : 0;
+    current = { salesTotal: round2(salesTotal), base: round2(base), commission: round2(commission), deductions: round2(deductions), advancesPaid: round2(advancesPaid), advancesPending: round2(advancesPending), salaryPaid: round2(salaryPaid), remaining: round2(base + commission - deductions - salaryPaid - advancesPaid), sheetIssued: Boolean(thisWeekEntry) };
+  }
+
+  return Response.json({
+    profile: { name: user.name, phone: user.phone, isOwner: user.roles.includes("super_admin") },
+    employee: employee ? { jobTitle: employee.job_title, branch: employee.branches?.name ?? "", weeklySalary: Number(employee.base_salary), commissionRate: Number(employee.commission_rate) } : null,
+    week: { start: week.start, end: week.end, hoursSeconds, shifts: (shifts.data ?? []).length },
+    current,
+    payroll: entries.map((e) => ({ id: e.id, periodStart: e.period_start, periodEnd: e.period_end, base: Number(e.base_salary), commission: Number(e.commission_amount), deductions: Number(e.deductions), paid: Number(e.amount_paid), remaining: round2(Number(e.base_salary) + Number(e.commission_amount) - Number(e.deductions) - Number(e.amount_paid)), status: e.status })),
+    advances: advanceRows,
+    leaves: leaves.data ?? [],
+  });
+}
