diff --git a/src/app/api/leave-requests/route.ts b/src/app/api/leave-requests/route.ts
new file mode 100644
index 0000000..9f7bcfa
--- /dev/null
+++ b/src/app/api/leave-requests/route.ts
@@ -0,0 +1,123 @@
+import { z } from "zod";
+import { getSupabaseAdmin } from "@/lib/supabase/admin";
+import { getCurrentUser, requirePermission, requireSameOrigin } from "@/lib/auth";
+import { audit } from "@/lib/audit";
+
+const uuid = z.string().uuid();
+const date = z.string().date();
+const time = z.string().regex(/^([01]\d|2[0-3]):[0-5]\d$/);
+const MAX_LEAVE_DAYS = 60;
+const MAX_PENDING = 10;
+const BACKDATE_DAYS = 7;
+
+const actionSchema = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("create"), branchId: uuid, type: z.enum(["leave", "permission"]), startDate: date, endDate: date.optional(), startTime: time.optional(), endTime: time.optional(), reason: z.string().trim().max(500).default("") }),
+  z.object({ action: z.literal("cancel"), requestId: uuid }),
+  z.object({ action: z.literal("decide"), requestId: uuid, decision: z.enum(["approve", "reject"]), note: z.string().trim().max(500).default("") }),
+]);
+
+const todayCairo = () => new Intl.DateTimeFormat("en-CA", { timeZone: "Africa/Cairo" }).format(new Date());
+const shiftDay = (day: string, delta: number) => { const d = new Date(`${day}T00:00:00Z`); d.setUTCDate(d.getUTCDate() + delta); return d.toISOString().slice(0, 10); };
+const dayCount = (from: string, to: string) => Math.round((new Date(`${to}T00:00:00Z`).getTime() - new Date(`${from}T00:00:00Z`).getTime()) / 86400000) + 1;
+const isOwner = (user: { roles: string[] }) => user.roles.includes("super_admin");
+const SELECT = "id,user_id,branch_id,request_type,start_date,end_date,start_time,end_time,reason,status,decision_note,created_at,decided_at,user_profiles(full_name,phone),branches(name)";
+
+export async function GET(request: Request) {
+  const user = await getCurrentUser();
+  if (!user) return Response.json({ error: "يلزم تسجيل الدخول" }, { status: 401 });
+  const admin = getSupabaseAdmin() as any;
+  const params = new URL(request.url).searchParams;
+
+  if (isOwner(user)) {
+    if (params.get("count") === "pending") {
+      const { count, error } = await admin.from("leave_requests").select("id", { count: "exact", head: true }).eq("status", "pending");
+      if (error) throw error;
+      return Response.json({ pending: count ?? 0 });
+    }
+    const status = z.enum(["pending", "approved", "rejected", "cancelled"]).safeParse(params.get("status") ?? "");
+    let query = admin.from("leave_requests").select(SELECT).order("created_at", { ascending: false }).limit(300);
+    if (status.success) query = query.eq("status", status.data);
+    const { data, error } = await query;
+    if (error) throw error;
+    return Response.json({ owner: true, requests: data ?? [] });
+  }
+
+  const { response } = await requirePermission("leave.request");
+  if (response) return response;
+  const { data, error } = await admin.from("leave_requests").select(SELECT).eq("user_id", user.id).order("created_at", { ascending: false }).limit(100);
+  if (error) throw error;
+  return Response.json({ owner: false, requests: data ?? [] });
+}
+
+export async function POST(request: Request) {
+  const parsed = actionSchema.safeParse(await request.json().catch(() => null));
+  if (!parsed.success) return Response.json({ error: "راجع بيانات الطلب" }, { status: 400 });
+  const input = parsed.data;
+  const { user, response } = await requirePermission(input.action === "decide" ? "staff.manage" : "leave.request");
+  if (response) return response;
+  if (!(await requireSameOrigin(request))) return Response.json({ error: "الطلب غير صالح" }, { status: 403 });
+  const admin = getSupabaseAdmin() as any;
+
+  if (input.action === "create") {
+    if (isOwner(user!)) return Response.json({ error: "تقديم الطلبات متاح لحسابات البائعين فقط" }, { status: 400 });
+    if (!user!.branchIds.includes(input.branchId)) return Response.json({ error: "اختر فرعًا من الفروع المسموح بها" }, { status: 403 });
+    const startDate = input.startDate;
+    let endDate = input.endDate ?? input.startDate;
+    let startTime: string | null = null;
+    let endTime: string | null = null;
+    if (input.type === "permission") {
+      endDate = startDate;
+      if (!input.startTime || !input.endTime) return Response.json({ error: "حدد وقت بداية ونهاية الاستئذان" }, { status: 400 });
+      if (input.endTime <= input.startTime) return Response.json({ error: "وقت النهاية يجب أن يكون بعد البداية" }, { status: 400 });
+      startTime = input.startTime; endTime = input.endTime;
+    } else {
+      if (endDate < startDate) return Response.json({ error: "نهاية الإجازة قبل بدايتها" }, { status: 400 });
+      if (dayCount(startDate, endDate) > MAX_LEAVE_DAYS) return Response.json({ error: `أقصى مدة للطلب الواحد ${MAX_LEAVE_DAYS} يومًا` }, { status: 400 });
+    }
+    const today = todayCairo();
+    if (startDate < shiftDay(today, -BACKDATE_DAYS)) return Response.json({ error: "لا يمكن تقديم طلب بتاريخ قديم" }, { status: 400 });
+    if (startDate > shiftDay(today, 366)) return Response.json({ error: "التاريخ بعيد جدًا" }, { status: 400 });
+
+    const active = await admin.from("leave_requests").select("id,request_type,start_date,end_date,start_time,end_time,status").eq("user_id", user!.id).in("status", ["pending", "approved"]).gte("end_date", shiftDay(today, -BACKDATE_DAYS - MAX_LEAVE_DAYS));
+    if (active.error) throw active.error;
+    const rows = (active.data ?? []) as Array<{ request_type: string; start_date: string; end_date: string; start_time: string | null; end_time: string | null; status: string }>;
+    if (rows.filter((r) => r.status === "pending").length >= MAX_PENDING) return Response.json({ error: "لديك طلبات كثيرة قيد المراجعة؛ انتظر قرار المالك" }, { status: 400 });
+    const overlap = rows.some((r) => {
+      if (r.request_type !== input.type || r.start_date > endDate || r.end_date < startDate) return false;
+      if (input.type === "leave") return true;
+      return (r.start_time ?? "") .slice(0, 5) < endTime! && (r.end_time ?? "").slice(0, 5) > startTime!;
+    });
+    if (overlap) return Response.json({ error: "لديك طلب سابق متداخل مع هذه الفترة" }, { status: 409 });
+
+    const employee = await admin.from("employees").select("id").eq("user_id", user!.id).maybeSingle();
+    if (employee.error) throw employee.error;
+    const { data, error } = await admin.from("leave_requests").insert({
+      user_id: user!.id, employee_id: employee.data?.id ?? null, branch_id: input.branchId, request_type: input.type,
+      start_date: startDate, end_date: endDate, start_time: startTime, end_time: endTime, reason: input.reason || null, created_by: user!.id,
+    }).select("id").single();
+    if (error) throw error;
+    await audit(user!.id, "leave.create", "leave_request", data.id, { type: input.type, startDate, endDate }).catch((e) => console.error(e));
+    return Response.json({ success: true, id: data.id }, { status: 201 });
+  }
+
+  if (input.action === "cancel") {
+    const { data, error } = await admin.from("leave_requests").update({ status: "cancelled", decided_by: user!.id, decided_at: new Date().toISOString() })
+      .eq("id", input.requestId).eq("user_id", user!.id).eq("status", "pending").select("id");
+    if (error) throw error;
+    if (!data?.length) return Response.json({ error: "لا يمكن إلغاء هذا الطلب" }, { status: 409 });
+    await audit(user!.id, "leave.cancel", "leave_request", input.requestId, {}).catch((e) => console.error(e));
+    return Response.json({ success: true });
+  }
+
+  const target = await admin.from("leave_requests").select("branch_id").eq("id", input.requestId).maybeSingle();
+  if (target.error) throw target.error;
+  if (!target.data) return Response.json({ error: "الطلب غير موجود" }, { status: 404 });
+  if (!isOwner(user!) && !user!.branchIds.includes(target.data.branch_id)) return Response.json({ error: "ليس لديك وصول لهذا الفرع" }, { status: 403 });
+  const { error } = await admin.rpc("decide_leave_request", { p_request: input.requestId, p_decision: input.decision, p_note: input.note, p_actor: user!.id });
+  if (error) {
+    if (error.message?.includes("not pending")) return Response.json({ error: "تم البت في هذا الطلب مسبقًا" }, { status: 409 });
+    throw error;
+  }
+  await audit(user!.id, `leave.${input.decision}`, "leave_request", input.requestId, { note: input.note }).catch((e) => console.error(e));
+  return Response.json({ success: true });
+}
