diff --git a/supabase/migrations/20261017150000_leave_requests.sql b/supabase/migrations/20261017150000_leave_requests.sql
new file mode 100644
index 0000000..5afe5ae
--- /dev/null
+++ b/supabase/migrations/20261017150000_leave_requests.sql
@@ -0,0 +1,57 @@
+-- Leave / permission requests: a seller submits, the owner approves or rejects.
+insert into public.permissions(key,description) values
+ ('leave.request','طلب إجازة أو استئذان')
+on conflict(key) do nothing;
+insert into public.role_permissions(role_id,permission_id)
+select r.id,p.id from public.roles r cross join public.permissions p
+where r.key='salesperson' and p.key='leave.request' on conflict do nothing;
+
+create table public.leave_requests(
+ id uuid primary key default gen_random_uuid(),
+ user_id uuid not null references public.user_profiles(id) on delete restrict,
+ employee_id uuid references public.employees(id) on delete set null,
+ branch_id uuid not null references public.branches(id) on delete restrict,
+ request_type text not null check(request_type in ('leave','permission')),
+ start_date date not null,
+ end_date date not null,
+ start_time time,
+ end_time time,
+ reason varchar(500),
+ status text not null default 'pending' check(status in ('pending','approved','rejected','cancelled')),
+ decision_note varchar(500),
+ created_by uuid not null references auth.users(id) on delete restrict,
+ decided_by uuid references auth.users(id) on delete set null,
+ created_at timestamptz not null default now(),
+ decided_at timestamptz,
+ check(end_date>=start_date),
+ -- a leave covers whole days; a permission is a few hours inside a single day
+ check(
+  (request_type='leave' and start_time is null and end_time is null)
+  or (request_type='permission' and start_date=end_date and start_time is not null and end_time is not null and end_time>start_time)
+ ),
+ check((status='pending' and decided_at is null) or (status<>'pending' and decided_at is not null))
+);
+create index leave_requests_user_time_idx on public.leave_requests(user_id,created_at desc);
+create index leave_requests_status_idx on public.leave_requests(status,created_at desc);
+create index leave_requests_branch_idx on public.leave_requests(branch_id);
+create index leave_requests_employee_idx on public.leave_requests(employee_id);
+alter table public.leave_requests enable row level security;
+revoke all on public.leave_requests from anon,authenticated;
+grant all on public.leave_requests to service_role;
+
+create or replace function public.decide_leave_request(p_request uuid,p_decision text,p_note text,p_actor uuid)
+returns void language plpgsql security definer set search_path = '' as $$
+declare v_status text;
+begin
+ select status into v_status from public.leave_requests where id=p_request for update;
+ if not found or v_status<>'pending' then raise exception 'request is not pending'; end if;
+ if p_decision not in ('approve','reject') then raise exception 'invalid decision'; end if;
+ update public.leave_requests
+ set status=case when p_decision='approve' then 'approved' else 'rejected' end,
+     decision_note=nullif(left(coalesce(p_note,''),500),''),
+     decided_by=p_actor,
+     decided_at=now()
+ where id=p_request;
+end $$;
+revoke all on function public.decide_leave_request(uuid,text,text,uuid) from public,anon,authenticated;
+grant execute on function public.decide_leave_request(uuid,text,text,uuid) to service_role;
