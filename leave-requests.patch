+"use client";
+import { useState } from "react";
+import OperationsSection from "@/components/operations-section";
+import StaffHours from "@/components/staff-hours";
+import { OwnerLeaveRequests } from "@/components/leave-requests";
+
+type Branch = { id: string; code: string; name: string; status: "ACTIVE" | "INACTIVE" };
+type View = "payroll" | "hours" | "leave";
+
+/** One "الموظفون" tab for the owner: payroll, working hours and leave/permission requests. */
+export default function StaffHub({ branches, branchIds, pendingLeave, onLeaveChanged }: { branches: Branch[]; branchIds: string[]; pendingLeave: number; onLeaveChanged: () => void }) {
+  const [view, setView] = useState<View>("payroll");
+  const items: Array<[View, string]> = [["payroll", "الموظفون والرواتب"], ["hours", "ساعات العمل"], ["leave", pendingLeave > 0 ? `طلبات الإجازة (${pendingLeave})` : "طلبات الإجازة"]];
+  return <>
+    <div className="sub-tabs" role="tablist" aria-label="أقسام الموظفين">
+      {items.map(([id, label]) => <button key={id} type="button" role="tab" aria-selected={view === id} className={`sub-tab ${view === id ? "selected" : ""}`} onClick={() => setView(id)}>{label}</button>)}
+    </div>
+    {view === "payroll" && <OperationsSection module="staff" branches={branches} branchIds={branchIds} isOwner />}
+    {view === "hours" && <StaffHours branches={branches} />}
+    {view === "leave" && <OwnerLeaveRequests onDecided={onLeaveChanged} />}
+  </>;
+}
