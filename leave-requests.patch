+"use client";
+import { FormEvent, useCallback, useEffect, useMemo, useState } from "react";
+
+type Branch = { id: string; name: string; status: "ACTIVE" | "INACTIVE" };
+type LeaveStatus = "pending" | "approved" | "rejected" | "cancelled";
+type LeaveRequest = {
+  id: string; user_id: string; branch_id: string; request_type: "leave" | "permission"; start_date: string; end_date: string;
+  start_time: string | null; end_time: string | null; reason: string | null; status: LeaveStatus; decision_note: string | null;
+  created_at: string; decided_at: string | null; user_profiles: { full_name: string; phone: string | null } | null; branches: { name: string } | null;
+};
+
+const STATUS_LABEL: Record<LeaveStatus, string> = { pending: "قيد المراجعة", approved: "تمت الموافقة", rejected: "مرفوض", cancelled: "ملغي" };
+const statusClass = (s: LeaveStatus) => (s === "approved" ? "status active" : s === "pending" ? "status" : "status inactive");
+const todayLocal = () => new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+const dayText = (d: string) => new Intl.DateTimeFormat("ar-EG", { weekday: "short", day: "numeric", month: "short" }).format(new Date(`${d}T00:00:00`));
+const days = (a: string, b: string) => Math.round((new Date(`${b}T00:00:00`).getTime() - new Date(`${a}T00:00:00`).getTime()) / 86400000) + 1;
+
+async function api(url: string, init?: RequestInit) {
+  const r = await fetch(url, { ...init, headers: { "content-type": "application/json", ...init?.headers }, cache: "no-store" });
+  const d = await r.json().catch(() => ({}));
+  if (!r.ok) throw new Error(d.error ?? "تعذر تنفيذ الطلب");
+  return d;
+}
+
+function Period({ r }: { r: LeaveRequest }) {
+  if (r.request_type === "permission") return <><strong>{dayText(r.start_date)}</strong><small>من {r.start_time?.slice(0, 5)} إلى {r.end_time?.slice(0, 5)}</small></>;
+  if (r.start_date === r.end_date) return <><strong>{dayText(r.start_date)}</strong><small>يوم واحد</small></>;
+  return <><strong>{dayText(r.start_date)} ← {dayText(r.end_date)}</strong><small>{days(r.start_date, r.end_date)} أيام</small></>;
+}
+const typeLabel = (r: LeaveRequest) => (r.request_type === "leave" ? "إجازة" : "استئذان");
+
+/** Seller side: submit a leave / permission request and follow its status. */
+export function SellerLeave({ branches, branchIds }: { branches: Branch[]; branchIds: string[] }) {
+  const mine = useMemo(() => branches.filter((b) => b.status === "ACTIVE" && branchIds.includes(b.id)), [branches, branchIds]);
+  const [requests, setRequests] = useState<LeaveRequest[]>([]);
+  const [form, setForm] = useState({ type: "leave" as "leave" | "permission", branchId: "", startDate: todayLocal(), endDate: todayLocal(), startTime: "10:00", endTime: "12:00", reason: "" });
+  const [error, setError] = useState(""); const [notice, setNotice] = useState(""); const [busy, setBusy] = useState(false);
+
+  const load = useCallback(async () => {
+    try { const j = await api("/api/leave-requests"); setRequests(j.requests ?? []); } catch (e) { setError(e instanceof Error ? e.message : "تعذر تحميل الطلبات"); }
+  }, []);
+  useEffect(() => { void load(); }, [load]);
+  useEffect(() => { if (!form.branchId && mine.length) setForm((f) => ({ ...f, branchId: mine[0].id })); }, [mine, form.branchId]);
+
+  async function submit(event: FormEvent) {
+    event.preventDefault(); setBusy(true); setError(""); setNotice("");
+    try {
+      const body = form.type === "leave"
+        ? { action: "create", type: "leave", branchId: form.branchId, startDate: form.startDate, endDate: form.endDate, reason: form.reason }
+        : { action: "create", type: "permission", branchId: form.branchId, startDate: form.startDate, startTime: form.startTime, endTime: form.endTime, reason: form.reason };
+      await api("/api/leave-requests", { method: "POST", body: JSON.stringify(body) });
+      setNotice("تم إرسال الطلب للمالك للمراجعة"); setForm((f) => ({ ...f, reason: "" })); await load();
+    } catch (e) { setError(e instanceof Error ? e.message : "تعذر إرسال الطلب"); } finally { setBusy(false); }
+  }
+  async function cancel(id: string) {
+    setBusy(true); setError(""); setNotice("");
+    try { await api("/api/leave-requests", { method: "POST", body: JSON.stringify({ action: "cancel", requestId: id }) }); setNotice("تم إلغاء الطلب"); await load(); }
+    catch (e) { setError(e instanceof Error ? e.message : "تعذر إلغاء الطلب"); } finally { setBusy(false); }
+  }
+
+  return <section className="panel operations-panel">
+    <div className="section-heading"><div><p className="eyebrow">طلبات الحضور</p><h2>طلب إجازة أو استئذان</h2></div></div>
+    {error && <div className="notice error" role="alert">{error}</div>}{notice && <div className="notice success" role="status">{notice}</div>}
+    <form className="ops-form" onSubmit={submit}>
+      <div className="ops-fields">
+        <label>نوع الطلب<select value={form.type} onChange={(e) => setForm({ ...form, type: e.target.value as "leave" | "permission" })}><option value="leave">إجازة (يوم أو أكثر)</option><option value="permission">استئذان (ساعات)</option></select></label>
+        {mine.length > 1 && <label>الفرع<select value={form.branchId} onChange={(e) => setForm({ ...form, branchId: e.target.value })}>{mine.map((b) => <option key={b.id} value={b.id}>{b.name}</option>)}</select></label>}
+        {form.type === "leave"
+          ? <><label>من تاريخ<input type="date" required value={form.startDate} onChange={(e) => setForm({ ...form, startDate: e.target.value, endDate: e.target.value > form.endDate ? e.target.value : form.endDate })} /></label><label>إلى تاريخ<input type="date" required min={form.startDate} value={form.endDate} onChange={(e) => setForm({ ...form, endDate: e.target.value })} /></label></>
+          : <><label>اليوم<input type="date" required value={form.startDate} onChange={(e) => setForm({ ...form, startDate: e.target.value })} /></label><label>من الساعة<input type="time" required value={form.startTime} onChange={(e) => setForm({ ...form, startTime: e.target.value })} /></label><label>إلى الساعة<input type="time" required value={form.endTime} onChange={(e) => setForm({ ...form, endTime: e.target.value })} /></label></>}
+        <label>السبب (اختياري)<input maxLength={500} value={form.reason} onChange={(e) => setForm({ ...form, reason: e.target.value })} /></label>
+      </div>
+      <button className="primary" disabled={busy || !form.branchId}>إرسال الطلب للمراجعة</button>
+    </form>
+    <h3 className="ops-subtitle">طلباتي</h3>
+    <div className="table-wrap"><table><thead><tr><th>النوع</th><th>الفترة</th><th>السبب</th><th>الحالة</th><th>ملاحظة المالك</th><th></th></tr></thead><tbody>
+      {requests.map((r) => <tr key={r.id}><td>{typeLabel(r)}</td><td><Period r={r} /></td><td>{r.reason || "—"}</td><td><span className={statusClass(r.status)}>{STATUS_LABEL[r.status]}</span></td><td>{r.decision_note || "—"}</td><td>{r.status === "pending" && <button type="button" className="row-action" disabled={busy} onClick={() => void cancel(r.id)}>إلغاء</button>}</td></tr>)}
+      {requests.length === 0 && <tr><td colSpan={6} className="table-empty">لم تقدّم أي طلبات بعد.</td></tr>}
+    </tbody></table></div>
+  </section>;
+}
+
+/** Owner side: review every request, approve or reject with an optional note. */
+export function OwnerLeaveRequests({ onDecided }: { onDecided?: () => void }) {
+  const [filter, setFilter] = useState<"pending" | "all" | "approved" | "rejected">("pending");
+  const [requests, setRequests] = useState<LeaveRequest[]>([]);
+  const [notes, setNotes] = useState<Record<string, string>>({});
+  const [error, setError] = useState(""); const [notice, setNotice] = useState(""); const [busy, setBusy] = useState(false);
+
+  const load = useCallback(async () => {
+    setError("");
+    try { const j = await api(`/api/leave-requests${filter === "all" ? "" : `?status=${filter}`}`); setRequests(j.requests ?? []); }
+    catch (e) { setError(e instanceof Error ? e.message : "تعذر تحميل الطلبات"); }
+  }, [filter]);
+  useEffect(() => { void load(); }, [load]);
+
+  async function decide(id: string, decision: "approve" | "reject") {
+    setBusy(true); setError(""); setNotice("");
+    try {
+      await api("/api/leave-requests", { method: "POST", body: JSON.stringify({ action: "decide", requestId: id, decision, note: notes[id] ?? "" }) });
+      setNotice(decision === "approve" ? "تمت الموافقة على الطلب" : "تم رفض الطلب"); await load(); onDecided?.();
+    } catch (e) { setError(e instanceof Error ? e.message : "تعذر حفظ القرار"); await load(); onDecided?.(); } finally { setBusy(false); }
+  }
+
+  return <section className="panel operations-panel">
+    <div className="section-heading"><div><p className="eyebrow">من حسابات البائعين</p><h2>طلبات الإجازة والاستئذان</h2></div>
+      <label className="ops-branch">عرض<select value={filter} onChange={(e) => setFilter(e.target.value as typeof filter)}><option value="pending">قيد المراجعة</option><option value="all">الكل</option><option value="approved">تمت الموافقة</option><option value="rejected">مرفوضة</option></select></label></div>
+    {error && <div className="notice error" role="alert">{error}</div>}{notice && <div className="notice success" role="status">{notice}</div>}
+    <div className="table-wrap"><table><thead><tr><th>الموظف</th><th>الفرع</th><th>النوع</th><th>الفترة</th><th>السبب</th><th>الحالة</th><th>القرار</th></tr></thead><tbody>
+      {requests.map((r) => <tr key={r.id}>
+        <td><strong>{r.user_profiles?.full_name ?? "—"}</strong><small>{r.user_profiles?.phone ?? ""}</small></td>
+        <td>{r.branches?.name ?? "—"}</td><td>{typeLabel(r)}</td><td><Period r={r} /></td><td>{r.reason || "—"}</td>
+        <td><span className={statusClass(r.status)}>{STATUS_LABEL[r.status]}</span>{r.status !== "pending" && r.decision_note && <small>{r.decision_note}</small>}</td>
+        <td>{r.status === "pending"
+          ? <div className="ops-inline-pay"><input aria-label="ملاحظة القرار" placeholder="ملاحظة (اختياري)" maxLength={500} value={notes[r.id] ?? ""} onChange={(e) => setNotes({ ...notes, [r.id]: e.target.value })} /><button type="button" className="row-action" disabled={busy} onClick={() => void decide(r.id, "approve")}>موافقة</button><button type="button" className="row-action" disabled={busy} onClick={() => void decide(r.id, "reject")}>رفض</button></div>
+          : "—"}</td>
+      </tr>)}
+      {requests.length === 0 && <tr><td colSpan={7} className="table-empty">{filter === "pending" ? "لا توجد طلبات قيد المراجعة." : "لا توجد طلبات."}</td></tr>}
+    </tbody></table></div>
+    <p className="footnote">الطلبات الملغاة من البائع تظهر ضمن «الكل» فقط.</p>
+  </section>;
+}
